# Copy to .env for local dev. In Replit, set these as Secrets. Never commit .env.
ENVIRONMENT=dev                     # dev | test | prod
DATABASE_URL=sqlite:///./agenthub.db  # Replit Postgres sets this automatically
SECRET_KEY=                         # python -c "import secrets;print(secrets.token_urlsafe(48))"
FERNET_KEY=                         # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                     # required to seed the admin account

# Signup approval (initial values; admins change them live in Admin -> Settings)
APPROVAL_MODE=auto                  # auto | manual
APPROVAL_SLA_HOURS=24
AUTO_APPROVE_ON_SLA_BREACH=false

# LLM — hybrid keys: platform keys below (capped per user), users may add their own.
# Leave all keys blank to run in demo mode (built-in sample model, zero cost).
DEFAULT_DAILY_TOKEN_CAP=50000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_FAKE_MODE=false
# Default models (verify current names on each vendor's site)
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# Approval notifications (owner gets every access request + SLA alerts with approval steps)
ADMIN_NOTIFY_EMAIL=                 # e.g. owner@example.com (editable in Admin -> Settings)
APP_BASE_URL=                       # public URL, used for links in emails
EMAIL_BACKEND=log                   # log (write to app log) | smtp (deliver)
SMTP_HOST=smtp.gmail.com            # Gmail: needs 2-Step Verification + an App Password
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                      # secret
SMTP_FROM=
