# Copy to .env for local dev. In Replit, set these as Secrets. Never commit .env.
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./agenthub.db          # Replit Postgres sets this automatically
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
FERNET_KEY=generate-with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# Signup approval
APPROVAL_MODE=auto                  # auto | manual
APPROVAL_SLA_HOURS=24
AUTO_APPROVE_ON_SLA_BREACH=false

# LLM (platform keys; users may also bring their own)
DEFAULT_DAILY_TOKEN_CAP=50000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
